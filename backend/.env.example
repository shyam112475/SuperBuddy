# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
# Base URL this API is reachable at — used to build absolute URLs for
# locally-stored uploads when Cloudinary isn't configured (see
# services/storage/localDevProvider.ts). Not used once Cloudinary is set.
PUBLIC_API_URL=http://localhost:4000/api

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/SuperBuddy?schema=public

# JWT (Phase 2)
# Generate strong random values, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Payments (Phase 6)
# Leave unset in dev to fall back to the mock provider automatically
# (see services/payments/mockProvider.ts) — not for production use.
# Use Razorpay TEST mode keys during development, never live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Redis (Phase 11)
REDIS_URL=

# Firebase Cloud Messaging (Phase 7)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Object storage (Phase 3/4)
# Leave unset in dev to fall back to local filesystem storage automatically
# (see services/storage/localDevProvider.ts) — not for production use.
CLOUDINARY_CLOUD_NAME=rahamj5i
CLOUDINARY_API_KEY=616456263989181
CLOUDINARY_API_SECRET=**********

# Dev-only admin seeding (Phase 10)
# Set both to create/promote a first admin account via `npx prisma db seed`.
# Leave unset in production — create admins by promoting an existing
# verified account directly, not via a seed script.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
