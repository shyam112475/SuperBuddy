# API base URL the app talks to.
#
# - iOS Simulator: http://localhost:4000/api works directly.
# - Android Emulator: use http://10.0.2.2:4000/api instead — the emulator's
#   loopback interface is not the host machine's localhost.
# - Physical device (either platform): use your computer's LAN IP, e.g.
#   http://192.168.1.23:4000/api, and make sure the device is on the same
#   network as the backend.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
