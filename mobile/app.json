{
  "expo": {
    "name": "CompanionHub",
    "slug": "companionhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "companionhub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.companionhub.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CompanionHub uses your location to send your position with an SOS alert if you ever need help during an activity.",
        "NSCameraUsageDescription": "CompanionHub uses your camera to let you set a profile photo.",
        "NSPhotoLibraryUsageDescription": "CompanionHub uses your photo library to let you set a profile photo."
      }
    },
    "android": {
      "package": "com.companionhub.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F3D3E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CompanionHub uses your location to send your position with an SOS alert if you ever need help during an activity."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
